# ============================================================
# Tunisia Tonight — Backend Environment Variables
# Copier ce fichier en .env et remplir les valeurs
# ============================================================

# Base de données PostgreSQL
DATABASE_URL="postgresql://tunisian_user:your_password@localhost:5432/tunisiatonight_db"

# JWT Secrets (générer avec : openssl rand -hex 64)
JWT_ACCESS_SECRET="your-super-secret-access-key-change-this-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-this-in-production"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# App
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Passerelle paiement TND (choisir une)
PAYMEE_API_KEY=""
PAYMEE_MERCHANT_ID=""
KONNECT_API_KEY=""
KONNECT_WALLET_ID=""

# AWS S3 (upload contrats PDF, photos)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_BUCKET_NAME="tunisiatonight-files"
AWS_REGION="eu-west-3"

# Email (Sendgrid)
SENDGRID_API_KEY=""
FROM_EMAIL="noreply@tunisiatonight.com"

# SMS (Twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
